<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>testttt</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="7.0.19" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="appsettings.json" />
    <Content Include="appsettings.Development.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="testttt.Presentation\testttt.Presentation.csproj" />
    <ProjectReference Include="testttt.Application\testttt.Application.csproj" />
    <ProjectReference Include="testttt.Infrastructure\testttt.Infrastructure.csproj" />
    <ProjectReference Include="testttt.Domain\testttt.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="testttt.Domain\obj\**" />
    <Compile Remove="testttt.Application\obj\**" />
    <Compile Remove="testttt.Infrastructure\obj\**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="testttt.Domain\obj\**" />
    <EmbeddedResource Remove="testttt.Application\obj\**" />
    <EmbeddedResource Remove="testttt.Infrastructure\obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="testttt.Domain\obj\**" />
    <None Remove="testttt.Application\obj\**" />
    <None Remove="testttt.Infrastructure\obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
